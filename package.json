{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && node scripts/build.mjs",
    "build:preview": "npm run validate:content && tsc -b && node scripts/build.mjs --preview",
    "validate:content": "node scripts/validate-content.mjs && node scripts/validate-images.mjs",
    "images:generate": "python scripts/optimize-images.py",
    "measure:assets": "node scripts/measure-assets.mjs",
    "test": "node --test tests/content.test.mjs tests/interface.test.mjs",
    "predeploy": "npm run lint && npm test && npm run build && npm run test:seo",
    "deploy": "gh-pages -d dist --nojekyll",
    "preview": "node scripts/preview.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "i18next": "^25.8.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "sass": "^1.99.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
